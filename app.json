{
    "offlineAccess": true,
    "runtime": {
        "arguments": "--v=1 --inspect",
        "version": "stable-v40"
    },
    "shortcut": {
        "company": "OpenFin",
        "description": "Platform app seed local",
        "icon": "https://openfin.github.io/golden-prototype/favicon.ico",
        "name": "Platform app seed local"
    },
    "platform": {
        "uuid": "platform_customization_local",
        "applicationIcon": "https://openfin.github.io/golden-prototype/favicon.ico",
        "autoShow": true,
        "providerUrl": "http://localhost:5555/provider.html",
        "enableJumpList": true,
        "permissions": {
            "ExternalWindow": {
                "wrap": true
            },
            "System": {
                "getAllExternalWindows": true,
                "launchExternalProcess": true,
                "readRegistryValue": false,
                "terminateExternalProcess": true
            },
            "webAPIs": [ "notifications", "audio", "video", "hid", "usb" ],
            "devices": [
                {
                    "vendorId": 5169,
                    "productId": 26240
                },
                {
                    "vendorId": 1452,
                    "productId": 591
                },
                {
                    "vendorId": 5169,
                    "productId": 30336
                },
                {
                    "vendorId": 8250,
                    "productId": 65531
                }
            ]
        },
        "defaultWindowOptions": {
            "disableDefaultCommands": true,
            "url": "http://localhost:5555/platform-window.html",
            "contextMenuSettings": {
                "reload": true,
                "devtools": true,
                "enable": true
            },
            "defaultWidth": 900,
            "defaultHeight": 720,
            "defaultLeft": 0,
            "defaultTop": 0,
            "saveWindowState": false,
            "backgroundThrottling": true,
            "minHeight": 445,
            "minWidth": 354,
            "experimental": {
                "analytics": true
            },
            "commands": [
                {
                    "command": "stack.nextTab",
                    "keys": "Ctrl+Tab"
                }
            ],
            "hotkeys": [
                {
                    "keys": "CommandOrControl+-"
                },
                {
                    "keys": "Shift+CommandOrControl+="
                },
                {
                    "keys": "Shift+CommandOrControl+-"
                },
                {
                    "keys": "Shift+CommandOrControl++"
                },
                {
                    "keys": "Shift+CommandOrControl+_"
                }
            ]
        },
        "defaultViewOptions": {
            "experimental": {
                "childWindows": true,
                "analytics": true
            }
        }
    },
    "snapshot": {
        "windows": [
            {
                "name": "Seed Window",
                "layout": {
                    "content": [
                        {
                            "type": "stack",
                            "id": "no-drop-target",
                            "content": [
                                {
                                    "type": "component",
                                    "componentName": "view",
                                    "componentState": {
                                        "processAffinity": "ps_1",
                                        "url": "https://cdn.openfin.co/health/deployment/index.html"
                                    }
                                },
                                {
                                    "type": "component",
                                    "componentName": "view",
                                    "componentState": {
                                        "processAffinity": "ps_1",
                                        "url": "https://google.com"
                                    }
                                }
                            ]
                        }
                    ]
                }
            }
        ]
    }
}
